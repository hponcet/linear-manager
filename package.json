{
  "name": "linear-manager",
  "displayName": "Linear Manager",
  "description": "Unofficial Linear extension for VS Code to manage issues within the editor.",
  "icon": "resources/images/linear_dark.png",
  "version": "0.0.7",
  "publisher": "hpon",
  "repository": "https://github.com/hponcet/linear-manager",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "------------ RUN ---------------------": "",
    "vscode:package": "vsce package",
    "ovsx:publish": "node scripts/ovsx-publish.cjs",
    "vscode:prepublish": "cross-env NODE_ENV=production npm run package",
    "compile": "webpack -c webpack.extension.js",
    "watch": "cross-env NODE_ENV=development npm-run-all --parallel watch:extension watch:react",
    "watch:extension": "cross-env NODE_ENV=development webpack --watch -c webpack.extension.js",
    "watch:react": "cross-env NODE_ENV=development webpack --watch -c webpack.react.js",
    "package": "webpack -c webpack.extension.js --mode production --devtool hidden-source-map && webpack -c webpack.react.js --mode production --devtool hidden-source-map",
    "------------ TESTS --------------------": "",
    "compile-tests": "tsc -p tsconfig.test.json --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "------------ DEV ----------------------": "",
    "preinstall": "$npm_execpath --silent run checknpm",
    "checknpm": "echo \"$npm_execpath\" | grep -q \"npm\" || (echo '⚠️  Use npm not yarn! ⚠️ ' && echo && exit 1)",
    "------------ CODE CHECKER -------------": "",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "ts-coverage": "typescript-coverage-report -i '**/*.js' -c",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0 --cache --cache-location .cache/.eslintcache",
    "lint:fix": "npm run lint --fix .",
    "lint:indent": "prettier --check . --ignore-path .lint-ignore --cache --cache-location .cache/.prettiercache",
    "lint:indent:fix": "npx prettier --check . --ignore-path .lint-ignore --cache --cache-location .cache/.prettiercache --write",
    "lint:styles": "stylelint ./src/**/*.css ./src/**/*.scss --ignore-path .lint-ignore --max-warnings 0 --cache --cache-location .cache/.stylelintcache",
    "lint:styles:fix": "npm run lint:styles --fix",
    "lint:all": "npm run lint && npm run lint:indent && npm run lint:styles",
    "lint:all:fix": "npm run lint:fix; npm run lint:indent:fix; npm run lint:styles:fix",
    "prepare": "husky"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linear-manager-issues",
          "title": "Linear manager",
          "icon": "resources/images/linear_dark.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "linearManager.views.connect",
        "contents": "In order to use Linear Manager plugin, connect your Linear account to get started.\n[Connect to Linear](command:linearManager.connect)",
        "when": "!linearManager:isLinearAuthenticated && linearManager:isLinearExtensionLoaded"
      }
    ],
    "views": {
      "linear-manager-issues": [
        {
          "id": "linearManager.views.connect",
          "name": "Connect to Linear",
          "icon": "resources/images/linear_dark.png",
          "when": "!linearManager:isLinearAuthenticated"
        },
        {
          "id": "linearManager.views.myIssues",
          "name": "My issues",
          "icon": "resources/images/linear_dark.png",
          "when": "linearManager:isLinearAuthenticated"
        }
      ]
    },
    "commands": [
      {
        "command": "linearManager.connect",
        "title": "Connect to Linear",
        "category": "Linear manager",
        "enablement": "!linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.disconnect",
        "title": "Disconnect from Linear",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.openIssue",
        "title": "Open Issue",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.openIssueExternal",
        "title": "Open Issue on Linear.app",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.startWork",
        "title": "Start work on issue",
        "icon": "$(play)",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.configureBranch",
        "title": "Configure branch for issue",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.checkoutIssue",
        "title": "Checkout to branch",
        "icon": "$(git-branch)",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.toggleViewMode",
        "title": "Toggle View: My Issues / Current Cycle",
        "icon": "$(list-filter)",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated"
      },
      {
        "command": "linearManager.commands.openCurrentBranchIssue",
        "title": "Open Issue for Current Branch",
        "category": "Linear manager",
        "enablement": "linearManager:isLinearAuthenticated && linearManager:isGitExtensionLoaded"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "linearManager.commands.openIssue",
          "when": "false"
        },
        {
          "command": "linearManager.commands.openIssueExternal",
          "when": "false"
        },
        {
          "command": "linearManager.commands.startWork",
          "when": "false"
        },
        {
          "command": "linearManager.commands.configureBranch",
          "when": "false"
        },
        {
          "command": "linearManager.commands.checkoutIssue",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "linearManager.commands.refresh",
          "when": "view == linearManager.views.myIssues",
          "group": "navigation"
        },
        {
          "command": "linearManager.commands.toggleViewMode",
          "when": "view == linearManager.views.myIssues",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "linearManager.commands.openIssue",
          "when": "viewItem =~ /^issueItem/",
          "group": "1open"
        },
        {
          "command": "linearManager.commands.openIssueExternal",
          "when": "viewItem =~ /^issueItem/",
          "group": "1open"
        },
        {
          "command": "linearManager.commands.startWork",
          "when": "viewItem == issueItem && linearManager:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearManager.commands.configureBranch",
          "when": "viewItem == issueItemWithBranch && linearManager:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearManager.commands.checkoutIssue",
          "when": "viewItem == issueItemWithBranch && linearManager:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearManager.commands.startWork",
          "when": "viewItem == issueItem && linearManager:isGitExtensionLoaded",
          "group": "inline"
        },
        {
          "command": "linearManager.commands.checkoutIssue",
          "when": "viewItem == issueItemWithBranch && linearManager:isGitExtensionLoaded",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "linearManager.commands.openCurrentBranchIssue",
        "key": "ctrl+k i",
        "mac": "cmd+k i"
      },
      {
        "command": "linearManager.commands.openCurrentBranchIssue",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i"
      }
    ]
  },
  "extensionDependencies": [
    "linear.linear-connect",
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@types/eslint": "^9.6.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.4.23",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "crypto-browserify": "^3.3.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "mini-css-extract-plugin": "^2.9.4",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.11",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.6.0",
    "process": "^0.11.10",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "sass-loader": "^16.0.6",
    "source-map-loader": "^5.0.0",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.1.1",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "-": "^0.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.16",
    "@linear/sdk": "^70.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-bubble-menu": "^3.15.3",
    "@tiptap/extension-highlight": "^3.15.3",
    "@tiptap/extension-horizontal-rule": "^3.15.3",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-list": "^3.15.3",
    "@tiptap/extension-subscript": "^3.15.3",
    "@tiptap/extension-superscript": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extensions": "^3.15.3",
    "@tiptap/markdown": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "emoji-picker-react": "^4.16.1",
    "lodash.throttle": "^4.1.1",
    "mime-types": "^3.0.2",
    "moment": "^2.30.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hotkeys-hook": "^5.2.1",
    "react-player": "^3.4.0",
    "rsuite": "^6.1.1",
    "serve": "^14.2.5",
    "simple-git": "^3.30.0"
  }
}
